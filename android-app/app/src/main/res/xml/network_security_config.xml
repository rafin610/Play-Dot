<?xml version="1.0" encoding="utf-8"?>
<!--
  Release/security baseline: cleartext HTTP is disabled. Production builds
  must use the HTTPS Render origin. Debug builds overlay this file with the
  narrow emulator/loopback allow-list for local testing; no local address is
  permitted by the release resource.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
