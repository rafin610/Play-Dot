# Copy this file to `.env` for local development, or enter the same values in
# Render's Environment tab. `.env` is gitignored and must never be committed.
#
# Required provider credentials. Values are validated by /health at startup;
# the server returns HTTP 503 (never a fake success response) if any are blank.
#
# The guest JWT lasts ~90 days. Rotate the token/user-ID pair with:
#   .venv/bin/python scripts/refresh_guest_token.py
# /health reports the current expiry and warns during the last 7 days.
MOVIEBOX_GUEST_TOKEN=<jwt-token>
MOVIEBOX_USER_ID=<user-id>
MOVIEBOX_GATEWAY_SECRET=<base64-secret>
MOVIEBOX_APPID=<appid>

# Optional: comma-separated browser origins allowed by CORS. localhost:3000 and
# localhost:3001 remain allowed by default for local dashboard development.
# CORS_ORIGINS=https://your-dashboard.example.com
# FRONTEND_URL=https://your-dashboard.example.com

# Session memory is bounded; Android keeps its session cookie in memory only and
# loses it when the app process restarts.
# SESSION_TTL_SECONDS=1800
# MAX_SESSIONS=500

# External desktop-player launch is a local-only convenience. Keep false on
# Render, where no desktop player binary exists.
# ENABLE_EXTERNAL_PLAYER=false

# Subtitle proxy safety limit (bytes).
# MAX_SUBTITLE_PROXY_BYTES=10485760

# Local JSON history is useful only for a single local process; Render's disk is
# ephemeral. Android watchlist/progress live in Android DataStore.
# HISTORY_FILE=local_history.json

# Local-only bind overrides. Render supplies PORT automatically; do not set it
# in Render's dashboard.
# HOST=0.0.0.0
# PORT=8000

# Android direct-APK update metadata. Leave unset to make /app-update return
# 503; the release client then treats updates as unavailable without showing an
# error. Do not publish debug or unsigned APKs. Prefer an external HTTPS
# artifact; Render's local disk is ephemeral.
# APP_UPDATE_LATEST_VERSION_CODE=3
# APP_UPDATE_LATEST_VERSION_NAME=1.1.0
# APP_UPDATE_MINIMUM_VERSION_CODE=1
# APP_UPDATE_RELEASE_NOTES=Bug fixes and playback improvements.
# APP_UPDATE_APK_URL=https://releases.example.com/play-dot-1.1.0.apk
# APP_UPDATE_APK_SHA256=166a92061a99af55345cb24b0b488be251298d880467a03bdc733539a619cbc8
# APP_UPDATE_APK_SIZE_BYTES=15964391
# APP_UPDATE_PACKAGE_NAME=com.streambox.mobile

# Optional local artifact for self-hosted testing only. If set, the backend
# computes sha256/size and serves it at /app-release.apk. Use an absolute path
# or a path relative to the repository root.
# APP_UPDATE_APK_PATH=/absolute/path/to/app-release.apk
